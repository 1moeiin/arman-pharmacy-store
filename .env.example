# Copy this file to .env and fill in real values. Never commit .env itself.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

SITE_NAME=داروخانه آرمان
SITE_DOMAIN=localhost:8000
SITE_SCHEME=http

DATABASE_URL=postgres://arman:arman@localhost:5432/arman_pharmacy
REDIS_URL=redis://127.0.0.1:6379/1

# ZarinPal payment gateway — https://www.zarinpal.com/panel
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=True

# Production-only (see config/settings/prod.py)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@example.com
DJANGO_ADMINS=
